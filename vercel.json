{
  "version": 2,
  "functions": {
    "api/index.js": {
      "runtime": "@vercel/node"
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "handle": "filesystem" },
    { "src": "/admin/?$", "dest": "/admin.html" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
